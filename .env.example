# ========== Runtime ==========
NODE_ENV=development
PORT=4000

# ========== CORS / BFF ==========
# Comma-separated list of allowed Origin values. Include Vercel preview wildcard for staging.
FRONTEND_ORIGIN=http://localhost:3000

# ========== Supabase (DB + Auth) ==========
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_rotated_service_role_key
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# ========== JWE request token (server-only) ==========
# Generate with: yarn keygen  (scripts/keygen/generate-jwe-keypair.mjs)
# Private key stays in the API. Public key goes to the frontend (also server-only).
LIZCO_API_REQUEST_PRIVKEY_JWK={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","kid":"...","alg":"ECDH-ES","use":"enc"}
# Previous private key during rotation window (accept for 24h)
LIZCO_API_REQUEST_PRIVKEY_JWK_PREV=

# Set automatically by Jest e2e (skips loading .env.local).
# LIZCO_E2E=

# ========== Throttle / cache ==========
# Optional Redis for anti-replay jti cache across instances.
REDIS_URL=

# ========== Integrations ==========
HCAPTCHA_SECRET=

# ========== Backoffice Admin Seed ==========
ADMIN_EMAIL=admin@global.tours
ADMIN_PASSWORD=change_me_in_production_use_strong_password

# ========== JWT Admin (Backoffice Auth) ==========
JWT_ADMIN_SECRET=replace_with_minimum_32_char_random_string
JWT_ADMIN_EXPIRES_IN=8h
